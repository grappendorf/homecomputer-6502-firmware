10 REM Todo-Liste fuer die serielle Konsole. 80 Spalten, 24 Zeilen.
20 REM Zeile 23 bleibt frei, damit Enter den Schirm nicht scrollt.
30 TERM 80,24
40 DIM Q$(40),F(40),S$(17)
50 M=40
60 W=18
70 Z$="                                                                                "
80 H$="--------------------------------------------------------------------------------"
90 N=5
100 E=1
110 P=1
120 Q$(1)="Firmware flashen"
130 Q$(2)="Serielle Konsole testen"
140 Q$(3)="Todo-Liste schreiben"
150 F(3)=1
160 Q$(4)="80 Spalten und 24 Zeilen pruefen"
170 Q$(5)="Aufgaben mit A, T und X pflegen"
180 G$=""
190 GOSUB 1000
200 GOSUB 1300
210 INPUT C$
220 GOSUB 1500
230 IF Y$="A" THEN GOSUB 2000:GOTO 320
240 IF Y$="T" THEN GOSUB 2200:GOTO 320
250 IF Y$="X" THEN GOSUB 2400:GOTO 320
260 IF Y$="U" THEN GOSUB 2600:GOTO 320
270 IF Y$="N" THEN GOSUB 2700:GOTO 320
280 IF Y$="P" THEN GOSUB 2800:GOTO 320
290 IF Y$="B" THEN GOSUB 2900:GOTO 320
300 IF Y$="Q" THEN GOTO 400
310 G$="unbekannter Befehl"
320 GOSUB 4000
330 GOTO 200
400 CLS:CURSOR ON:PRINT "Todo beendet.":END
1000 CLS
1010 CURSOR OFF
1020 GOSUB 3300
1030 GOSUB 3400
1040 V$=L$
1050 LOCATE 0,0:PRINT L$;
1060 LOCATE 1,0:PRINT H$;
1070 FOR J=0 TO W-1
1080 I=P+J
1090 GOSUB 3600
1100 S$(J)=L$
1110 LOCATE 2+J,0
1120 PRINT L$;
1130 NEXT J
1140 LOCATE 20,0:PRINT H$;
1150 LOCATE 21,0
1160 L$=" A neu   T fertig   X weg   U hoch   N runter   P/B seite   Q ende  Enter=Stop"
1170 L$=LEFT$(L$+Z$,80)
1180 PRINT L$;
1190 RETURN
1300 CURSOR ON
1310 LOCATE 22,0
1320 PRINT ">";
1330 PRINT LEFT$(Z$,79);
1340 LOCATE 22,1
1350 RETURN
1500 Y$=""
1510 X$=""
1520 IF LEN(C$)=0 THEN RETURN
1530 Y$=LEFT$(C$,1)
1540 C=ASC(Y$)
1550 IF C>96 AND C<123 THEN Y$=CHR$(C-32)
1560 IF LEN(C$)=1 THEN RETURN
1570 X$=MID$(C$,2)
1580 IF LEN(X$)=0 THEN RETURN
1590 IF LEFT$(X$,1)<>" " THEN RETURN
1600 X$=MID$(X$,2)
1610 GOTO 1580
2000 IF X$="" THEN G$="Text fehlt":RETURN
2010 IF N>=M THEN G$="Liste voll":RETURN
2020 B=0
2030 IF LEN(X$)>68 THEN X$=LEFT$(X$,68):B=1
2040 N=N+1
2050 Q$(N)=X$
2060 F(N)=0
2070 E=N
2080 GOSUB 3000
2090 G$="angelegt"
2100 IF B=1 THEN G$="angelegt, auf 68 gekuerzt"
2110 RETURN
2200 IF N=0 THEN G$="keine Aufgaben":RETURN
2210 GOSUB 3100
2220 IF B=1 THEN RETURN
2230 IF F(E)=0 THEN F(E)=1:G$="fertig":RETURN
2240 F(E)=0
2250 G$="offen"
2260 RETURN
2400 IF N=0 THEN G$="keine Aufgaben":RETURN
2410 GOSUB 3100
2420 IF B=1 THEN RETURN
2430 IF E>=N THEN GOTO 2480
2440 FOR I=E TO N-1
2450 Q$(I)=Q$(I+1)
2460 F(I)=F(I+1)
2470 NEXT I
2480 Q$(N)=""
2490 N=N-1
2500 IF N=0 THEN E=0:P=1:G$="geloescht":RETURN
2510 IF E>N THEN E=N
2520 GOSUB 3000
2530 G$="geloescht"
2540 RETURN
2600 IF N=0 THEN G$="keine Aufgaben":RETURN
2610 IF E>1 THEN E=E-1
2620 GOSUB 3000
2630 G$=""
2640 RETURN
2700 IF N=0 THEN G$="keine Aufgaben":RETURN
2710 IF E<N THEN E=E+1
2720 GOSUB 3000
2730 G$=""
2740 RETURN
2800 IF N=0 THEN G$="keine Aufgaben":RETURN
2810 E=E+W
2820 IF E>N THEN E=N
2830 GOSUB 3000
2840 G$=""
2850 RETURN
2900 IF N=0 THEN G$="keine Aufgaben":RETURN
2910 E=E-W
2920 IF E<1 THEN E=1
2930 GOSUB 3000
2940 G$=""
2950 RETURN
3000 IF N=0 THEN P=1:RETURN
3010 IF E<1 THEN E=1
3020 IF E<P THEN P=E
3030 IF E>P+W-1 THEN P=E-W+1
3040 RETURN
3100 B=0
3110 IF X$="" THEN RETURN
3120 V=INT(VAL(X$))
3130 IF V<1 OR V>N THEN GOTO 3160
3140 E=V
3150 GOSUB 3000:RETURN
3160 B=1
3170 G$="keine solche Nummer"
3180 RETURN
3300 O=0
3310 D=0
3320 IF N=0 THEN RETURN
3330 FOR I=1 TO N
3340 IF F(I)=0 THEN O=O+1
3350 IF F(I)<>0 THEN D=D+1
3360 NEXT I
3370 RETURN
3400 R$="offen"
3410 R$=R$+STR$(O)
3420 R$=R$+"  fertig"
3430 R$=R$+STR$(D)
3440 L$=" TODO  "
3450 L$=L$+G$
3460 K=80-LEN(R$)
3470 IF LEN(L$)>K THEN L$=LEFT$(L$,K)
3480 L$=LEFT$(L$+Z$,K)
3490 L$=L$+R$
3500 RETURN
3600 L$=Z$
3610 IF N<>0 THEN GOTO 3640
3620 IF J<>0 THEN RETURN
3630 L$="  (leer - A und ein Text legt eine Aufgabe an)"
3635 L$=LEFT$(L$+Z$,80)
3636 RETURN
3640 IF I<1 OR I>N THEN RETURN
3650 U$=" "
3660 IF I=E THEN U$=">"
3670 D$=MID$(STR$(I),2)
3680 D$=RIGHT$("   "+D$,3)
3690 B$="[ ]"
3700 IF F(I)<>0 THEN B$="[x]"
3710 L$=U$+D$
3720 L$=L$+" "
3730 L$=L$+B$
3740 L$=L$+" "
3750 T$=Q$(I)
3760 IF LEN(T$)>68 THEN T$=LEFT$(T$,68)
3770 L$=L$+T$
3780 L$=LEFT$(L$+Z$,80)
3790 RETURN
4000 CURSOR OFF
4010 GOSUB 3300
4020 GOSUB 3400
4030 IF L$=V$ THEN GOTO 4060
4040 V$=L$
4050 LOCATE 0,0:PRINT L$;
4060 FOR J=0 TO W-1
4070 I=P+J
4080 GOSUB 3600
4090 IF L$=S$(J) THEN GOTO 4120
4100 S$(J)=L$
4110 LOCATE 2+J,0:PRINT L$;
4120 NEXT J
4130 RETURN
