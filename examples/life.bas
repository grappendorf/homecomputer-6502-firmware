1000 REM Conway, 40x4, world in W$. Neighbours wrap.
1010 CLS
1020 CURSOR OFF
1030 W$=""
1040 FOR I=1 TO 4
1050 W$=W$+"                                        "
1060 NEXT I
1070 FOR I=1 TO 40
1080 P=INT(RND(1)*160)+1
1090 W$=LEFT$(W$,P-1)+"*"+MID$(W$,P+1)
1100 NEXT I
1110 GOSUB 7000
2000 X=0
2010 Y=0
3000 GOSUB 8100
3010 C=0
3020 X=X0: Y=YT: GOSUB 8200
3030 X=XR: Y=YT: GOSUB 8200
3040 X=XR: Y=Y0: GOSUB 8200
3050 X=XR: Y=YB: GOSUB 8200
3060 X=X0: Y=YB: GOSUB 8200
3070 X=XL: Y=YB: GOSUB 8200
3080 X=XL: Y=Y0: GOSUB 8200
3090 X=XL: Y=YT: GOSUB 8200
5000 X=X0: Y=Y0
5010 P=Y*40+X+1
5020 A$=MID$(W$,P,1)
5030 B$=A$
5040 IF A$<>"*" AND C=3 THEN B$="*"
5050 IF A$="*" AND (C<2 OR C>3) THEN B$=" "
5060 IF B$=A$ THEN GOTO 6000
5070 W$=LEFT$(W$,P-1)+B$+MID$(W$,P+1)
5080 LOCATE Y,X
5090 PRINT B$;
6000 X=X0+1
6010 IF X<40 THEN GOTO 3000
6020 X=0
6030 Y=Y0+1
6040 IF Y<4 THEN GOTO 3000
6050 GOTO 2000
7000 FOR R=0 TO 3
7010 LOCATE R,0
7020 PRINT MID$(W$,R*40+1,40);
7030 NEXT R
7040 RETURN
8100 X0=X
8110 Y0=Y
8120 YT=Y+3: YT=YT-INT(YT/4)*4
8130 YB=Y+1: YB=YB-INT(YB/4)*4
8140 XL=X+39: XL=XL-INT(XL/40)*40
8150 XR=X+1: XR=XR-INT(XR/40)*40
8160 RETURN
8200 P=Y*40+X+1
8210 IF MID$(W$,P,1)="*" THEN C=C+1
8220 RETURN
