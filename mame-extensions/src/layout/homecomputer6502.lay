<?xml version="1.0"?>
<!-- license:MIT -->
<!-- HomeComputer 6502 - case + keyboard artwork with the live LCD composited in.
     Key positions match docs/keyboard-matrix.md section 4 (physical layout). -->
<mamelayout version="2">

	<element name="hc_case">
		<rect><color alpha="0" /><bounds x="0" y="0" width="1120" height="640" /></rect>
		<!-- outer case: wider, less tall than before, matching the real unit's squat proportions -->
		<rect>
			<color red="0.886" green="0.349" blue="0.059" />
			<bounds x="20" y="20" width="1080" height="600" />
		</rect>
		<!-- recessed top panel (LCD + speakers) -->
		<rect>
			<color red="0.722" green="0.267" blue="0.039" />
			<bounds x="42" y="42" width="1036" height="190" />
		</rect>
		<!-- LCD window. Same blue as the panel, visible as a 4px rim around the screen. -->
		<rect>
			<color red="0.118" green="0.196" blue="0.549" />
			<bounds x="270" y="66" width="580" height="140" />
		</rect>
	</element>

	<element name="hc_grille">
		<rect><color red="0.125" green="0.114" blue="0.102" /><bounds x="0" y="0" width="16" height="16" /></rect>
	</element>

	<!-- status LED (VIA1 PA7, see system-spec.md 5.7 / homecomputer6502.cpp via1_pa_w), built into
	     the top-right hole of the right speaker grille -->
	<element name="hc_led" defstate="0">
		<disk state="0">
			<color red="0.28" green="0.05" blue="0.03" />
		</disk>
		<disk state="1">
			<color red="1.0" green="0.18" blue="0.05" />
		</disk>
	</element>

	<!-- Invisible-until-pressed overlay for every clickable key: transparent at rest, a cool
	     blue while held, so mouse clicks on the drawn keyboard actually
	     drive the emulated ROWn keyboard-matrix ioports (see INPUT_PORTS_START in
	     homecomputer6502.cpp for the tag/bit -> key assignment this mirrors). -->
	<element name="hc_key" defstate="0">
		<rect state="0">
			<color alpha="0" />
		</rect>
		<rect state="1">
			<color red="0.45" green="0.62" blue="0.78" alpha="0.62" />
		</rect>
	</element>

	<element name="hc_keyboard">
		<rect><color alpha="0" /><bounds x="0" y="0" width="1120" height="640" /></rect>
		<rect>
			<color red="0.12" green="0.12" blue="0.12" />
			<bounds x="70.0" y="270.0" width="52.9" height="46" />
		</rect>
		<text string="Esc">
			<color red="0.92" green="0.91" blue="0.87" />
			<bounds xc="96.5" yc="293.0" width="44.9" height="25.3" />
		</text>
		<rect>
			<color red="0.12" green="0.12" blue="0.12" />
