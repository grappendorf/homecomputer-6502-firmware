	<view name="HomeComputer 6502">
		<element ref="hc_case">
			<bounds x="0" y="0" width="1120" height="640" />
		</element>

		<repeat count="6">
			<param name="gy" start="63" increment="26" />
			<repeat count="5">
				<param name="gx" start="70" increment="26" />
				<element ref="hc_grille">
					<bounds x="~gx~" y="~gy~" width="16" height="16" />
				</element>
			</repeat>
		</repeat>
		<repeat count="6">
			<param name="gy2" start="63" increment="26" />
			<repeat count="5">
				<param name="gx2" start="920" increment="26" />
				<element ref="hc_grille">
					<bounds x="~gx2~" y="~gy2~" width="16" height="16" />
				</element>
			</repeat>
		</repeat>

		<!-- status LED, replaces the top-right hole of the right speaker grille (x=920+4*26=1024, y=63) -->
		<element ref="hc_led" name="led0">
			<bounds x="1024" y="63" width="16" height="16" />
		</element>

		<!-- native screen is 240x36 px. Inset 4px so the blue window shows as a rim
		     and the glyphs do not sit on the orange edge. -->
